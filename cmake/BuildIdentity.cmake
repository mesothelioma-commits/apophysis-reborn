# Configure-time source identity. A release archive carries release-source.json;
# an ordinary exported source tree without it is honestly reported as unknown.
set(apo_source_revision "unknown")
set(apo_source_origin "unknown")
set(apo_source_dirty_known 0)
set(apo_source_dirty 0)
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --show-toplevel
        OUTPUT_VARIABLE apo_git_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE apo_git_result)
    file(REAL_PATH "${PROJECT_SOURCE_DIR}" apo_source_root)
    if(apo_git_result EQUAL 0 AND apo_git_root STREQUAL apo_source_root)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse HEAD
            OUTPUT_VARIABLE apo_source_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" status --porcelain --untracked-files=normal
            OUTPUT_VARIABLE apo_git_status COMMAND_ERROR_IS_FATAL ANY)
        set(apo_source_origin "git")
        set(apo_source_dirty_known 1)
        if(NOT apo_git_status STREQUAL "")
            set(apo_source_dirty 1)
        endif()
        foreach(apo_git_name HEAD index packed-refs)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --git-path "${apo_git_name}"
                OUTPUT_VARIABLE apo_git_path OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            get_filename_component(apo_git_path "${apo_git_path}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
            if(EXISTS "${apo_git_path}")
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${apo_git_path}")
            endif()
        endforeach()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" symbolic-ref -q HEAD
            OUTPUT_VARIABLE apo_git_ref OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT apo_git_ref STREQUAL "")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PROJECT_SOURCE_DIR}" rev-parse --git-path "${apo_git_ref}"
                OUTPUT_VARIABLE apo_git_path OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            get_filename_component(apo_git_path "${apo_git_path}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${apo_git_path}")
        endif()
        # Reconfiguration follows edits/additions in the shipped project inputs.
        execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.quotepath=false -C "${PROJECT_SOURCE_DIR}" ls-files
            OUTPUT_VARIABLE apo_tracked_text OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        string(REPLACE "\n" ";" apo_tracked_inputs "${apo_tracked_text}")
        foreach(apo_tracked IN LISTS apo_tracked_inputs)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${apo_tracked}")
        endforeach()
        file(GLOB_RECURSE apo_identity_inputs CONFIGURE_DEPENDS
            "${PROJECT_SOURCE_DIR}/src/*" "${PROJECT_SOURCE_DIR}/tests/*"
            "${PROJECT_SOURCE_DIR}/docs/*" "${PROJECT_SOURCE_DIR}/scripts/*"
            "${PROJECT_SOURCE_DIR}/cmake/*" "${PROJECT_SOURCE_DIR}/packaging/*"
            "${PROJECT_SOURCE_DIR}/examples/*" "${PROJECT_SOURCE_DIR}/shaders/*"
            "${PROJECT_SOURCE_DIR}/third_party/*" "${PROJECT_SOURCE_DIR}/preview/*"
            "${PROJECT_SOURCE_DIR}/benchmarks/*" "${PROJECT_SOURCE_DIR}/licenses/*")
        list(FILTER apo_identity_inputs EXCLUDE REGEX "(/__pycache__/|[.]pyc$)")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            ${apo_identity_inputs} "${PROJECT_SOURCE_DIR}/README.md" "${PROJECT_SOURCE_DIR}/CMakeLists.txt")
    endif()
endif()
if(apo_source_origin STREQUAL "unknown" AND EXISTS "${PROJECT_SOURCE_DIR}/release-source.json")
    file(SIZE "${PROJECT_SOURCE_DIR}/release-source.json" apo_identity_size)
    if(apo_identity_size GREATER 4096)
        message(FATAL_ERROR "release-source.json exceeds the source-identity limit")
    endif()
    file(READ "${PROJECT_SOURCE_DIR}/release-source.json" apo_identity_json)
    string(JSON apo_identity_schema GET "${apo_identity_json}" schema_version)
    string(JSON apo_identity_version GET "${apo_identity_json}" version)
    string(JSON apo_source_revision GET "${apo_identity_json}" source_revision)
    string(JSON apo_identity_dirty GET "${apo_identity_json}" source_dirty)
    string(JSON apo_identity_dirty_type TYPE "${apo_identity_json}" source_dirty)
    if(NOT apo_identity_schema EQUAL 1 OR NOT apo_identity_version STREQUAL PROJECT_VERSION
       OR NOT apo_identity_dirty_type STREQUAL "BOOLEAN" OR apo_source_revision STREQUAL "unknown")
        message(FATAL_ERROR "release-source.json has incompatible source metadata")
    endif()
    set(apo_source_origin "release-source.json")
    # A revision label alone cannot establish that an extracted tree is clean.
    # New release archives carry a hash-anchored manifest of Git source files.
    if(apo_identity_dirty)
        set(apo_source_dirty 1)
    endif()
    string(JSON apo_manifest ERROR_VARIABLE apo_manifest_error GET "${apo_identity_json}" source_manifest)
    if(NOT apo_manifest_error)
        string(JSON apo_manifest_expected GET "${apo_identity_json}" source_manifest_sha256)
        if(NOT apo_manifest STREQUAL "SOURCE_SHA256SUMS.txt" OR
           NOT EXISTS "${PROJECT_SOURCE_DIR}/${apo_manifest}")
            message(FATAL_ERROR "The release source manifest is missing or has an unsupported name")
        endif()
        file(SIZE "${PROJECT_SOURCE_DIR}/${apo_manifest}" apo_manifest_size)
        if(apo_manifest_size GREATER 1048576 OR apo_manifest_size EQUAL 0)
            message(FATAL_ERROR "The release source manifest has an invalid size")
        endif()
        file(SHA256 "${PROJECT_SOURCE_DIR}/${apo_manifest}" apo_manifest_actual)
        if(NOT apo_manifest_actual STREQUAL apo_manifest_expected)
            message(FATAL_ERROR "The release source manifest differs from release-source.json")
        endif()
        file(STRINGS "${PROJECT_SOURCE_DIR}/${apo_manifest}" apo_manifest_lines ENCODING UTF-8)
        file(REAL_PATH "${PROJECT_SOURCE_DIR}" apo_source_root)
        set(apo_manifest_paths)
        foreach(apo_line IN LISTS apo_manifest_lines)
            if(NOT apo_line MATCHES "^([0-9a-f]+)  (.+)$")
                message(FATAL_ERROR "Invalid release source checksum line")
            endif()
            set(apo_expected "${CMAKE_MATCH_1}")
            set(apo_relative "${CMAKE_MATCH_2}")
            string(LENGTH "${apo_expected}" apo_hash_length)
            if(NOT apo_hash_length EQUAL 64 OR IS_ABSOLUTE "${apo_relative}" OR
               apo_relative MATCHES "(^|/)\\.\\.?(/|$)|[:\\\\;]" OR
               apo_relative IN_LIST apo_manifest_paths)
                message(FATAL_ERROR "Invalid or duplicate path in release source manifest")
            endif()
            list(APPEND apo_manifest_paths "${apo_relative}")
            set(apo_input "${PROJECT_SOURCE_DIR}/${apo_relative}")
            file(REAL_PATH "${apo_input}" apo_resolved)
            cmake_path(IS_PREFIX apo_source_root "${apo_resolved}" NORMALIZE apo_inside_source)
            if(NOT apo_inside_source OR IS_SYMLINK "${apo_input}" OR
               NOT EXISTS "${apo_input}" OR IS_DIRECTORY "${apo_input}")
                set(apo_source_dirty 1)
            else()
                file(SHA256 "${apo_input}" apo_actual)
                if(NOT apo_actual STREQUAL apo_expected)
                    set(apo_source_dirty 1)
                endif()
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${apo_input}")
        endforeach()
        if(NOT "CMakeLists.txt" IN_LIST apo_manifest_paths OR NOT "src/build_info.cpp" IN_LIST apo_manifest_paths)
            message(FATAL_ERROR "The release source manifest omits required source inputs")
        endif()
        set(apo_source_dirty_known 1)
        set(apo_source_origin "release-source.json+manifest")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${apo_manifest}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/release-source.json")
endif()
if(NOT apo_source_revision STREQUAL "unknown")
    string(LENGTH "${apo_source_revision}" apo_revision_length)
    if(NOT apo_revision_length EQUAL 40 OR NOT apo_source_revision MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Source revision must be a full lowercase SHA-1 Git commit")
    endif()
endif()
set(apo_editor_compiled 0)
set(apo_qt_version "")
if(APO_BUILD_EDITOR)
    set(apo_editor_compiled 1)
    set(apo_qt_version "${Qt6Core_VERSION}")
endif()
configure_file("${PROJECT_SOURCE_DIR}/cmake/apo_build_config.hpp.in"
    "${PROJECT_BINARY_DIR}/generated/apo_build_config.hpp" @ONLY)
