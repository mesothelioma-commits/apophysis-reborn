{ Original Apophysis-style API, interpreted by the strict Pascal subset. }
var i: Integer;
begin
  Clear;
  Flame.Name := 'Legacy triangles';
  Flame.Width := 640;
  Flame.Height := 480;
  Flame.Scale := 12;
  for i := 0 to 2 do
  begin
    AddTransform;
    Transform.a := 0.5;
    Transform.d := 0.5;
    Transform.e := Cos(i * 2 * Pi / 3);
    Transform.f := Sin(i * 2 * Pi / 3);
    Transform.Color := i / 2;
    Transform.Weight := 1;
    Transform.Linear := 1;
  end;
  Print('Created ' + IntToStr(Transforms) + ' transforms');
end.
