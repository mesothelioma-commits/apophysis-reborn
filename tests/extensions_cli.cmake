if(NOT EXE OR NOT SAMPLE OR NOT MANIFEST OR NOT WORK)
    message(FATAL_ERROR "EXE, SAMPLE, MANIFEST and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
# All outputs below are isolated test artifacts and overwritten only within this directory.
set(case_dir "${WORK}/formats-and-scripting")
file(REMOVE_RECURSE "${case_dir}")
file(MAKE_DIRECTORY "${case_dir}")
file(SHA256 "${SAMPLE}" sample_before)

function(run_ok)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "Expected success: ${ARGN}\n${output}\n${error}")
    endif()
    set(result "${output}" PARENT_SCOPE)
    set(diagnostics "${error}" PARENT_SCOPE)
endfunction()
function(run_bad)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(rc STREQUAL "0")
        message(FATAL_ERROR "Expected failure: ${ARGN}\n${output}")
    endif()
    if(rc MATCHES "timeout|Timeout")
        message(FATAL_ERROR "Unexpected test timeout: ${ARGN}")
    endif()
    set(diagnostics "${error}" PARENT_SCOPE)
endfunction()
function(absent path)
    if(EXISTS "${path}")
        message(FATAL_ERROR "Failed command published an output: ${path}")
    endif()
endfunction()
function(same_file a b)
    file(SHA256 "${a}" first)
    file(SHA256 "${b}" second)
    if(NOT first STREQUAL second)
        message(FATAL_ERROR "Files differ: ${a} / ${b}")
    endif()
endfunction()

# Native projects preserve the complete original collection and selected entry.
set(library "${case_dir}/original.flame")
file(WRITE "${library}" "<Flames name='preserve'>\r\n<!-- keep exact source -->\r\n<flame name='First' size='8 6' scale='2'><xform weight='1' linear='1' coefs='0.5 0 0 0.5 0 0'/><color index='0' rgb='255 64 32'/></flame>\r\n<flame name='Selected' size='8 6' scale='2'><xform weight='1' linear='1' coefs='0.5 0 0 0.5 0 0'/><color index='0' rgb='255 64 32'/></flame>\r\n</Flames>\r\n")
set(project "${case_dir}/native.apoproject")
run_ok(project create "${library}" --output "${project}" --index 2)
run_ok(project inspect "${project}")
if(NOT result MATCHES "Native project version 1" OR NOT result MATCHES "Flames: 2" OR NOT result MATCHES "Selected: 2")
    message(FATAL_ERROR "Incomplete native project inspection: ${result}")
endif()
run_ok(project extract "${project}" --output "${case_dir}/extracted.flame")
same_file("${library}" "${case_dir}/extracted.flame")
file(READ "${project}" envelope)
string(REPLACE "</apophysis-project>" "<metadata><setting key='author' value='Keep me' extension='keep'/></metadata><future-workspace value='opaque'/></apophysis-project>" envelope "${envelope}")
file(WRITE "${project}" "${envelope}")
run_ok(save "${project}" --output "${case_dir}/native-copy.apoproject")
same_file("${project}" "${case_dir}/native-copy.apoproject")
run_ok(save "${project}" --output "${case_dir}/native-edited.apoproject" --name "Native edited")
file(READ "${case_dir}/native-edited.apoproject" edited)
if(NOT edited MATCHES "extension='keep'" OR NOT edited MATCHES "<future-workspace value='opaque'/>")
    message(FATAL_ERROR "Normal native save dropped unknown project data")
endif()
run_ok(inspect "${case_dir}/native-edited.apoproject" --json)
string(JSON first_name GET "${result}" entries 0 name)
string(JSON second_name GET "${result}" entries 1 name)
if(NOT first_name STREQUAL "First" OR NOT second_name STREQUAL "Native edited")
    message(FATAL_ERROR "Native save did not use its persisted selected entry: ${result}")
endif()
run_bad(project create "${library}" --output "${project}")
same_file("${project}" "${case_dir}/native-copy.apoproject")
string(REPLACE "version=\"1\" selected" "version=\"999\" selected" future "${envelope}")
file(WRITE "${case_dir}/future.apoproject" "${future}")
run_bad(project inspect "${case_dir}/future.apoproject")
run_bad(project extract "${case_dir}/future.apoproject" --output "${case_dir}/future-output.flame")
absent("${case_dir}/future-output.flame")
file(WRITE "${case_dir}/malformed.apoproject" "<apophysis-project version='1'><flame-library encoding='base64'>not base64!</flame-library></apophysis-project>")
run_bad(project inspect "${case_dir}/malformed.apoproject")

# UGR/MAP interchange is tested through the command line, including failed import.
run_ok(palette-export "${SAMPLE}" --output "${case_dir}/palette.ugr")
run_ok(palette-import "${case_dir}/palette.ugr" --flame "${SAMPLE}" --output "${case_dir}/ugr.flame")
run_ok(palette-export "${case_dir}/ugr.flame" --output "${case_dir}/from-ugr.map")
run_ok(palette-export "${SAMPLE}" --output "${case_dir}/original.map")
same_file("${case_dir}/from-ugr.map" "${case_dir}/original.map")
run_ok(palette-import "${case_dir}/original.map" --flame "${SAMPLE}" --output "${case_dir}/map.apoproject")
run_ok(palette-export "${case_dir}/map.apoproject" --output "${case_dir}/from-map.map")
same_file("${case_dir}/original.map" "${case_dir}/from-map.map")
file(WRITE "${case_dir}/unsupported.ugr" "No { gradient: smooth=yes index=0 color=0 }\n")
run_bad(palette-import "${case_dir}/unsupported.ugr" --flame "${SAMPLE}" --output "${case_dir}/bad-palette.flame")
absent("${case_dir}/bad-palette.flame")

# The UPR path supports the old Apophysis dialect and refuses arbitrary formulas.
get_filename_component(sample_folder "${SAMPLE}" DIRECTORY)
run_ok(upr-import "${sample_folder}/classic-upr-study.upr" --output "${case_dir}/upr.apoproject")
run_ok(upr-export "${case_dir}/upr.apoproject" --output "${case_dir}/roundtrip.upr")
run_ok(upr-import "${case_dir}/roundtrip.upr" --output "${case_dir}/upr-roundtrip.flame")
file(WRITE "${case_dir}/unsupported.upr" "Other { fractal: title=\"Unknown\" layers=1 formula: filename=\"other.ufm\" entry=\"other\" outside: filename=\"other.ucl\" entry=\"other\" }\n")
run_bad(upr-import "${case_dir}/unsupported.upr" --output "${case_dir}/unknown-upr.flame")
absent("${case_dir}/unknown-upr.flame")
file(WRITE "${case_dir}/no-upr.flame" "<flame name='Post affine' size='8 6' scale='2' filter='0.5' vibrancy='1'><xform weight='1' linear='1' coefs='0.5 0 0 0.5 0 0' post='1 0 0 1 0.1 0'/><color index='0' rgb='255 64 32'/></flame>")
run_bad(upr-export "${case_dir}/no-upr.flame" --output "${case_dir}/must-not-write.upr")
absent("${case_dir}/must-not-write.upr")

# Sidecar inspection and project references never enable a native module.
run_ok(plugins info "${MANIFEST}")
if(NOT result MATCHES "sample_wave" OR NOT result MATCHES "SHA-256")
    message(FATAL_ERROR "Plugin information missing: ${result}")
endif()
set(plugin_flame "${case_dir}/plugin.flame")
file(WRITE "${plugin_flame}" "<flame name='Plugin' size='8 6' scale='2'><xform weight='1' sample_wave='1' sample_wave_amplitude='0.2' sample_wave_frequency='3' coefs='0.5 0 0 0.5 0 0'/><color index='0' rgb='255 64 32'/></flame>")
run_ok(inspect "${plugin_flame}" --json)
string(JSON status GET "${result}" entries 0 status)
if(NOT status STREQUAL "preserve-only")
    message(FATAL_ERROR "Native variation unexpectedly loaded without --plugin")
endif()
run_ok(project create "${plugin_flame}" --output "${case_dir}/plugin.apoproject")
file(READ "${case_dir}/plugin.apoproject" plugin_project)
string(REPLACE "</apophysis-project>" "<plugins><plugin id='org.apophysis.reborn.wave' path='data-only'/></plugins></apophysis-project>" plugin_project "${plugin_project}")
file(WRITE "${case_dir}/plugin.apoproject" "${plugin_project}")
run_ok(inspect "${case_dir}/plugin.apoproject" --json)
string(JSON status GET "${result}" entries 0 status)
if(NOT status STREQUAL "preserve-only")
    message(FATAL_ERROR "Project plugin reference enabled code")
endif()
run_ok(--plugin "${MANIFEST}" inspect "${plugin_flame}" --json)
string(JSON status GET "${result}" entries 0 status)
if(NOT status STREQUAL "renderable")
    message(FATAL_ERROR "Explicit plugin enable did not make its flame renderable: ${result}")
endif()
run_ok(--plugin "${MANIFEST}" --flame "${plugin_flame}" --samples 2000 --threads 1 --output "${case_dir}/plugin.bmp")

# Exercise the distributed tutorial flame, including its saved ID, parameters and palette.
set(wave_png "${case_dir}/sample-wave.png")
run_ok(--plugin "${MANIFEST}" --flame "${sample_folder}/plugins/reborn-wave/sample-wave.flame"
    --samples 2000 --threads 1 --output "${wave_png}")
file(READ "${wave_png}" wave_header LIMIT 24 HEX)
if(NOT wave_header STREQUAL "89504e470d0a1a0a0000000d4948445200000280000001e0")
    message(FATAL_ERROR "The bundled sample wave did not render a 640x480 PNG")
endif()

# Scripts edit private documents; side outputs require explicit capabilities.
file(WRITE "${case_dir}/edit.lua" "apo.set_flame {name='CLI Lua'}\nprint('lua completed')\n")
run_ok(script "${project}" --script "${case_dir}/edit.lua" --output "${case_dir}/lua.apoproject")
run_ok(inspect "${case_dir}/lua.apoproject" --json)
string(JSON lua_name GET "${result}" entries 1 name)
if(NOT lua_name STREQUAL "CLI Lua")
    message(FATAL_ERROR "Lua did not edit the selected native-project flame")
endif()
file(READ "${case_dir}/lua.apoproject" lua_project)
if(NOT lua_project MATCHES "future-workspace" OR NOT lua_project MATCHES "extension='keep'")
    message(FATAL_ERROR "Script discarded native project metadata")
endif()
file(WRITE "${case_dir}/edit.asc" "begin\n Flame.Name := 'CLI Legacy';\nend.\n")
run_ok(script "${SAMPLE}" --script "${case_dir}/edit.asc" --output "${case_dir}/legacy.flame")
run_ok(inspect "${case_dir}/legacy.flame" --json)
string(JSON legacy_name GET "${result}" entries 0 name)
if(NOT legacy_name STREQUAL "CLI Legacy")
    message(FATAL_ERROR "Legacy script edit did not apply")
endif()
file(WRITE "${case_dir}/export.lua" "apo.set_flame {name='Must remain private'}\napo.export_flame('side.flame')\n")
run_bad(script "${SAMPLE}" --script "${case_dir}/export.lua" --output "${case_dir}/denied.flame" --output-dir "${case_dir}/denied-outputs")
absent("${case_dir}/denied.flame")
absent("${case_dir}/denied-outputs/side.flame")
file(MAKE_DIRECTORY "${case_dir}/allowed-outputs")
run_ok(script "${SAMPLE}" --script "${case_dir}/export.lua" --output "${case_dir}/allowed.flame" --allow-exports --output-dir "${case_dir}/allowed-outputs")
if(NOT EXISTS "${case_dir}/allowed-outputs/side.flame")
    message(FATAL_ERROR "Explicit export capability did not publish requested output")
endif()
file(WRITE "${case_dir}/render.lua" "apo.render('side.png', {width=8,height=6,samples=1000})\n")
run_bad(script "${SAMPLE}" --script "${case_dir}/render.lua" --output "${case_dir}/denied-render.flame" --output-dir "${case_dir}/denied-outputs")
absent("${case_dir}/denied-render.flame")
absent("${case_dir}/denied-outputs/side.png")
file(WRITE "${case_dir}/failure.lua" "apo.set_flame {name='Never publish'}\nerror('intentional failure')\n")
run_bad(script "${SAMPLE}" --script "${case_dir}/failure.lua" --output "${case_dir}/failed-script.flame")
absent("${case_dir}/failed-script.flame")
file(WRITE "${case_dir}/loop.lua" "while true do end\n")
run_bad(script "${SAMPLE}" --script "${case_dir}/loop.lua" --output "${case_dir}/loop.flame" --instructions 5000 --timeout-ms 1000)
absent("${case_dir}/loop.flame")
file(SHA256 "${SAMPLE}" sample_after)
if(NOT sample_before STREQUAL sample_after)
    message(FATAL_ERROR "An extension command modified its source sample")
endif()
