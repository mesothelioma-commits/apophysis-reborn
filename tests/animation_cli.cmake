if(NOT EXE OR NOT SAMPLE OR NOT MANIFEST OR NOT WORK)
    message(FATAL_ERROR "EXE, SAMPLE, MANIFEST and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(case_dir "${WORK}/animation-workflows")
file(REMOVE_RECURSE "${case_dir}")
file(MAKE_DIRECTORY "${case_dir}")
file(SHA256 "${SAMPLE}" sample_before)
function(run_ok)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "Expected success: ${ARGN}\n${output}\n${error}")
    endif()
    set(result "${output}" PARENT_SCOPE)
    set(diagnostics "${error}" PARENT_SCOPE)
endfunction()
function(run_bad)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(rc STREQUAL "0" OR rc MATCHES "timeout|Timeout")
        message(FATAL_ERROR "Expected a prompt failure: ${ARGN}\n${output}\n${error}")
    endif()
    set(diagnostics "${error}" PARENT_SCOPE)
endfunction()
function(run_paused)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(NOT rc STREQUAL "75")
        message(FATAL_ERROR "Expected explicit pause status 75: ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
function(absent path)
    if(EXISTS "${path}")
        message(FATAL_ERROR "Failed/read-only command published ${path}")
    endif()
endfunction()
function(same_file a b)
    file(SHA256 "${a}" first)
    file(SHA256 "${b}" second)
    if(NOT first STREQUAL second)
        message(FATAL_ERROR "Files differ: ${a} / ${b}")
    endif()
endfunction()
set(library "${case_dir}/original.flame")
file(WRITE "${library}" "<Flames name='preserve'>\r\n<!-- exact original source -->\r\n<flame name='First' size='12 8' scale='3' time='0' center='0 0'><xform weight='1' linear='1' coefs='0.5 0 0 0.5 0 0'/><color index='0' rgb='255 64 32'/></flame>\r\n<flame name='Selected' size='12 8' scale='3' time='2' center='2 0'><xform weight='1' linear='1' coefs='0.5 0 0 0.5 0 0'/><color index='0' rgb='32 64 255'/></flame>\r\n</Flames>\r\n")
set(project "${case_dir}/source.apoproject")
run_ok(project create "${library}" --index 2 --output "${project}")
file(READ "${project}" envelope)
string(REPLACE "</apophysis-project>" "<future-timeline extension='untouched'/><metadata><setting key='author' value='Keep me' extension='preserved'/></metadata></apophysis-project>" envelope "${envelope}")
file(WRITE "${project}" "${envelope}")
set(clip "${case_dir}/orbit.apoproject")
run_ok(animation create "${project}" --preset camera-orbit --frames 5 --fps 30000/1001
    --seed 18446744073709551615 --output "${clip}")
run_ok(animation inspect "${clip}" --json)
string(JSON count GET "${result}" frame_count)
string(JSON numerator GET "${result}" rate numerator)
string(JSON denominator GET "${result}" rate denominator)
string(JSON seed GET "${result}" seed)
string(JSON selected GET "${result}" keyframes 0 source_index)
if(NOT count STREQUAL "5" OR NOT numerator STREQUAL "30000" OR NOT denominator STREQUAL "1001"
    OR NOT seed STREQUAL "18446744073709551615" OR NOT selected STREQUAL "2")
    message(FATAL_ERROR "Animation timing/selection/seed metadata is wrong: ${result}")
endif()
run_ok(project extract "${clip}" --output "${case_dir}/extracted.flame")
same_file("${library}" "${case_dir}/extracted.flame")
file(READ "${clip}" native)
if(NOT native MATCHES "<future-timeline extension='untouched'/>" OR NOT native MATCHES "extension='preserved'")
    message(FATAL_ERROR "Animation save dropped unknown native project data")
endif()
run_ok(save "${clip}" --output "${case_dir}/clip-copy.apoproject")
same_file("${clip}" "${case_dir}/clip-copy.apoproject")
run_bad(animation create "${clip}" --output "${case_dir}/implicit-replacement.apoproject")
absent("${case_dir}/implicit-replacement.apoproject")
run_ok(animation create "${clip}" --replace-animation --preset zoom --frames 3
    --output "${case_dir}/replacement.apoproject")
run_bad(animation create "${project}" --output "${project}" --overwrite)
run_bad(animation create "${project}" --output "${case_dir}/wrong.flame")
run_bad(animation create "${project}" --frames 0 --output "${case_dir}/zero.apoproject")
run_bad(animation create "${project}" --fps 30/0 --output "${case_dir}/bad-rate.apoproject")
run_bad(animation create "${project}" --frames 3 --frames 4 --output "${case_dir}/duplicate.apoproject")

# An unsupported payload remains opaque and requires an explicit replacement decision.
string(REPLACE "</apophysis-project>" "<animation encoding='base64'>ZnV0dXJlAA==</animation></apophysis-project>" opaque "${envelope}")
file(WRITE "${case_dir}/opaque.apoproject" "${opaque}")
run_ok(animation inspect "${case_dir}/opaque.apoproject" --json)
string(JSON supported GET "${result}" supported)
if(supported)
    message(FATAL_ERROR "Unknown animation payload was treated as supported")
endif()
run_ok(save "${case_dir}/opaque.apoproject" --output "${case_dir}/opaque-copy.apoproject")
same_file("${case_dir}/opaque.apoproject" "${case_dir}/opaque-copy.apoproject")
run_bad(animation create "${case_dir}/opaque.apoproject" --output "${case_dir}/opaque-replaced.apoproject")
run_ok(animation create "${case_dir}/opaque.apoproject" --replace-animation --frames 3
    --output "${case_dir}/opaque-replaced.apoproject")

# Deterministic evaluated frames can be inspected as explicit standalone flame files.
run_ok(animation frame "${clip}" --frame 2 --output "${case_dir}/middle.flame")
file(READ "${case_dir}/middle.flame" middle)
if(NOT middle MATCHES "rotate=\"180\"")
    message(FATAL_ERROR "Orbit midpoint was not evaluated correctly: ${middle}")
endif()
run_bad(animation frame "${clip}" --frame 2 --output "${clip}" --overwrite)
run_bad(animation frame "${clip}" --frame 2 --samples 100 --output "${case_dir}/misleading.flame")
run_ok(animation frame "${clip}" --frame 2 --width 16 --height 12 --samples 8192 --threads 1
    --format png16 --alpha --output "${case_dir}/middle.png")
run_ok(animation add "${clip}" --flame "${library}" --index 1 --at 2 --easing linear
    --name "Added midpoint" --output "${case_dir}/added.apoproject")
run_ok(animation inspect "${case_dir}/added.apoproject" --json)
string(JSON key_count LENGTH "${result}" keyframes)
if(NOT key_count STREQUAL "3")
    message(FATAL_ERROR "Add keyframe did not produce three keys: ${result}")
endif()
run_bad(animation add "${clip}" --flame "${library}" --at 0 --output "${case_dir}/duplicate-key.apoproject")
run_ok(animation add "${clip}" --flame "${library}" --at 0 --replace-keyframe
    --output "${case_dir}/replaced-key.apoproject")
run_ok(animation morph "${library}" --from-index 1 --to "${library}" --to-index 2 --frames 5
    --easing linear --palette linear-rgb --from-ids branch --to-ids branch
    --output "${case_dir}/morph.apoproject")
run_ok(animation frame "${case_dir}/morph.apoproject" --frame 2 --output "${case_dir}/morph-middle.flame")
file(READ "${case_dir}/morph-middle.flame" midpoint)
if(NOT midpoint MATCHES "center=\"1 0\"")
    message(FATAL_ERROR "Morph midpoint camera was not interpolated correctly: ${midpoint}")
endif()
run_ok(animation import "${library}" --time-units frames --fps 24 --output "${case_dir}/timed.apoproject")
run_ok(animation inspect "${case_dir}/timed.apoproject" --json)
string(JSON count GET "${result}" frame_count)
if(NOT count STREQUAL "3")
    message(FATAL_ERROR "Timed library frame import used the wrong units")
endif()
run_bad(animation import "${library}" --output "${case_dir}/ambiguous-time.apoproject")

# Full preflight creates neither outputs nor sequence state. Global numbering is
# preserved across inclusive ranges and independently resumed batches.
set(sequence "${case_dir}/sequence")
file(MAKE_DIRECTORY "${sequence}")
run_ok(animation render "${clip}" --output-dir "${sequence}" --first 1 --last 3 --step 2
    --samples 8192 --threads 1 --estimate)
if(NOT result MATCHES "2 selected frames" OR NOT result MATCHES "frame_000001.png" OR NOT result MATCHES "frame_000003.png")
    message(FATAL_ERROR "Sequence preflight range/names are wrong: ${result}")
endif()
absent("${sequence}/.apo-sequence-frame")
absent("${sequence}/frame_000001.png")
run_paused(animation render "${clip}" --output-dir "${sequence}" --first 1 --last 3 --step 2
    --samples 8192 --threads 1 --pause-after-frames 1)
if(NOT EXISTS "${sequence}/frame_000001.png")
    message(FATAL_ERROR "Paused sequence lost its completed frame")
endif()
absent("${sequence}/frame_000003.png")
run_bad(animation render "${clip}" --output-dir "${sequence}" --first 1 --last 3 --step 2
    --samples 8193 --threads 1 --resume)
run_ok(animation render "${clip}" --output-dir "${sequence}" --first 1 --last 3 --step 2
    --samples 8192 --threads 2 --resume)
run_ok(animation render "${clip}" --output-dir "${sequence}" --first 1 --last 3 --step 2
    --samples 8192 --threads 1 --resume)
if(NOT result MATCHES "0 rendered, 2 verified")
    message(FATAL_ERROR "Completed sequence was not hash-verified before skipping: ${result}")
endif()
file(SHA256 "${sequence}/.apo-sequence-frame/manifest.aposequence" manifest_before)
file(APPEND "${sequence}/frame_000001.png" "corrupt")
run_bad(animation render "${clip}" --output-dir "${sequence}" --first 1 --last 3 --step 2
    --samples 8192 --threads 1 --resume)
if(NOT diagnostics MATCHES "missing or changed")
    message(FATAL_ERROR "Changed completed frame did not receive a clear diagnostic: ${diagnostics}")
endif()
file(SHA256 "${sequence}/.apo-sequence-frame/manifest.aposequence" manifest_after)
if(NOT manifest_before STREQUAL manifest_after)
    message(FATAL_ERROR "Corrupt-complete preflight changed sequence state")
endif()

set(sample_resume "${case_dir}/sample-resume")
set(sample_clean "${case_dir}/sample-clean")
file(MAKE_DIRECTORY "${sample_resume}" "${sample_clean}")
run_paused(animation render "${clip}" --output-dir "${sample_resume}" --first 0 --last 0
    --samples 16384 --threads 1 --pause-after-samples 8192)
absent("${sample_resume}/frame_000000.png")
run_ok(animation render "${clip}" --output-dir "${sample_resume}" --first 0 --last 0
    --samples 16384 --threads 1 --resume)
run_ok(animation render "${clip}" --output-dir "${sample_clean}" --first 0 --last 0
    --samples 16384 --threads 1)
same_file("${sample_resume}/frame_000000.png" "${sample_clean}/frame_000000.png")
run_bad(animation render "${clip}" --output-dir "${sample_clean}" --first 0 --last 0 --samples 16384)
run_bad(animation render "${clip}" --output-dir "${sample_clean}" --prefix ../escape --first 0 --last 0)
run_bad(animation render "${clip}" --output-dir "${sample_clean}" --prefix new --state-dir "${case_dir}")
run_bad(animation render "${clip}" --output-dir "${sample_clean}" --prefix new --first 0 --last 0 --step 0)
run_bad(animation render "${clip}" --output-dir "${sample_clean}" --prefix new --first 0 --last 0 --disk-mib 1)
absent("${sample_clean}/new_000000.png")

# Merely reading a project never enables its native code. Explicit global
# --plugin enablement is required for capture/evaluation and every fresh host.
set(plugin_flame "${case_dir}/plugin.flame")
file(WRITE "${plugin_flame}" "<flame name='Plugin' size='12 8' scale='3'><xform weight='1' sample_wave='1' sample_wave_amplitude='0.2' sample_wave_frequency='3' coefs='0.5 0 0 0.5 0 0'/><color index='0' rgb='255 64 32'/></flame>")
run_bad(animation create "${plugin_flame}" --frames 2 --output "${case_dir}/missing-module.apoproject")
absent("${case_dir}/missing-module.apoproject")
run_ok(--plugin "${MANIFEST}" animation create "${plugin_flame}" --frames 2
    --output "${case_dir}/plugin.apoproject")
run_ok(animation inspect "${case_dir}/plugin.apoproject" --json)
file(MAKE_DIRECTORY "${case_dir}/plugin-sequence")
run_bad(animation render "${case_dir}/plugin.apoproject" --output-dir "${case_dir}/plugin-sequence"
    --samples 8192 --threads 1)
absent("${case_dir}/plugin-sequence/.apo-sequence-frame")
run_ok(--plugin "${MANIFEST}" animation render "${case_dir}/plugin.apoproject"
    --output-dir "${case_dir}/plugin-sequence" --samples 8192 --threads 1)
file(SHA256 "${SAMPLE}" sample_after)
if(NOT sample_before STREQUAL sample_after)
    message(FATAL_ERROR "Animation workflows modified the bundled source flame")
endif()
message(STATUS "Animation CLI: native preservation, presets/morphs/timed import, evaluated frames, safe sequences, partial resume and module boundaries passed")
