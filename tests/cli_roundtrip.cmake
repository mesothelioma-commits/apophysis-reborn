# Exercise the packaged CLI contract through filenames containing spaces.
file(MAKE_DIRECTORY "${WORK}")
set(output "${WORK}/test render.bmp")
function(run_ok)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE msg ERROR_VARIABLE err)
    if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "Render failed: ${err} ${msg}")
    endif()
endfunction()
run_ok(--flame "${SAMPLE}" --output "${output}" --seed 48 --samples 55001 --threads 1)
file(SHA256 "${output}" single)
run_ok(--flame "${SAMPLE}" --output "${output}" --seed 48 --samples 55001 --threads 4)
file(SHA256 "${output}" parallel)
file(READ "${output}" signature LIMIT 2 HEX)
file(READ "${output}" dims OFFSET 18 LIMIT 8 HEX)
file(SIZE "${output}" size)
if(NOT single STREQUAL parallel OR NOT signature STREQUAL "424d" OR
   NOT dims STREQUAL "0003000040020000" OR NOT size EQUAL 1327158)
    message(FATAL_ERROR "BMP header, length, or deterministic overwrite failed")
endif()
foreach(bad IN ITEMS "--index;0" "--samples;-1" "--seed;2junk" "--memory-mib;1")
    execute_process(COMMAND "${EXE}" --flame "${SAMPLE}" --output "${output}" ${bad}
        RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    file(SHA256 "${output}" after)
    if(rc STREQUAL "0" OR NOT single STREQUAL after)
        message(FATAL_ERROR "Invalid option accepted or output was overwritten: ${bad}")
    endif()
endforeach()
