execute_process(COMMAND "${EXE}" --version RESULT_VARIABLE result OUTPUT_VARIABLE version ERROR_VARIABLE error TIMEOUT 10)
string(STRIP "${version}" version)
if(NOT result EQUAL 0 OR NOT version STREQUAL "Apophysis Reborn ${VERSION}")
    message(FATAL_ERROR "Version command failed: ${result} ${version} ${error}")
endif()
execute_process(COMMAND "${EXE}" --build-info --json RESULT_VARIABLE result OUTPUT_VARIABLE info ERROR_VARIABLE error TIMEOUT 10)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Build information failed: ${result} ${error}")
endif()
string(JSON schema GET "${info}" schema)
string(JSON actual_version GET "${info}" version)
string(JSON revision GET "${info}" source_revision)
string(JSON origin GET "${info}" source_origin)
string(JSON dirty_type TYPE "${info}" source_dirty)
string(JSON vulkan GET "${info}" vulkan_compiled)
string(JSON editor GET "${info}" editor_compiled)
string(JSON compiler GET "${info}" compiler)
string(JSON arch GET "${info}" target_arch)
string(JSON bits GET "${info}" pointer_bits)
if(NOT schema STREQUAL "apophysis-reborn.build-info" OR NOT actual_version STREQUAL VERSION
   OR NOT vulkan STREQUAL VULKAN OR NOT editor STREQUAL EDITOR
   OR compiler STREQUAL "" OR arch STREQUAL "" OR NOT bits EQUAL POINTER_BITS)
    message(FATAL_ERROR "Build information does not match its configured binary: ${info}")
endif()
if(revision STREQUAL "unknown" OR origin STREQUAL "release-source.json")
    if(NOT dirty_type STREQUAL "NULL")
        message(FATAL_ERROR "Unknown source identity incorrectly claims clean/dirty provenance")
    endif()
else()
    string(LENGTH "${revision}" revision_length)
    if(NOT revision_length EQUAL 40 OR NOT revision MATCHES "^[0-9a-f]+$" OR NOT dirty_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "Invalid source identity: ${info}")
    endif()
endif()
execute_process(COMMAND "${EXE}" --build-info RESULT_VARIABLE result OUTPUT_VARIABLE plain TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT plain MATCHES "Source revision:" OR NOT plain MATCHES "Runtime device availability")
    message(FATAL_ERROR "Readable build report is incomplete")
endif()
foreach(option IN ITEMS --version --build-info)
    execute_process(COMMAND "${EXE}" "${option}" --output should-not-exist.png
        WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(result EQUAL 0 OR EXISTS "${WORK}/should-not-exist.png")
        message(FATAL_ERROR "Informational command accepted render options or wrote an image")
    endif()
endforeach()
