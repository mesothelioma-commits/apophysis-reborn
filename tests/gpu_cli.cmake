# The discovery/fallback contract runs even on a machine without Vulkan.
# A usable explicit device additionally exercises actual compute file output.
file(MAKE_DIRECTORY "${WORK}")
set(output "${WORK}/backend render.ppm")

function(run_ok)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE msg ERROR_VARIABLE err)
    if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "CLI command failed (${ARGN}): ${err} ${msg}")
    endif()
    set(last_output "${msg}" PARENT_SCOPE)
endfunction()

function(run_preserved_failure)
    file(SHA256 "${output}" before)
    execute_process(COMMAND "${EXE}" --flame "${SAMPLE}" --output "${output}" --samples 16387 ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE msg ERROR_VARIABLE err)
    file(SHA256 "${output}" after)
    if(rc STREQUAL "0" OR NOT before STREQUAL after)
        message(FATAL_ERROR "Invalid/strict request succeeded or replaced existing output (${ARGN}): ${msg} ${err}")
    endif()
endfunction()

run_ok(--list-devices --json)
set(discovery "${last_output}")
foreach(key IN ITEMS compiled loader_available)
    string(JSON type ERROR_VARIABLE problem TYPE "${discovery}" "${key}")
    if(problem OR NOT type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "Invalid discovery JSON boolean ${key}: ${discovery}")
    endif()
endforeach()
string(JSON type ERROR_VARIABLE problem TYPE "${discovery}" diagnostic)
if(problem OR NOT type STREQUAL "STRING")
    message(FATAL_ERROR "Invalid discovery diagnostic: ${discovery}")
endif()
string(JSON device_count ERROR_VARIABLE problem LENGTH "${discovery}" devices)
if(problem)
    message(FATAL_ERROR "Invalid discovery devices: ${discovery}")
endif()
set(selected_index "")
set(hardware_available FALSE)
if(device_count GREATER 0)
    math(EXPR last_index "${device_count} - 1")
    foreach(i RANGE 0 ${last_index})
        foreach(key IN ITEMS id name type api_version driver_version reason)
            string(JSON type ERROR_VARIABLE problem TYPE "${discovery}" devices ${i} ${key})
            if(problem OR NOT type STREQUAL "STRING")
                message(FATAL_ERROR "Invalid discovery device string ${key}: ${discovery}")
            endif()
        endforeach()
        foreach(key IN ITEMS usable software float64 int64)
            string(JSON type ERROR_VARIABLE problem TYPE "${discovery}" devices ${i} ${key})
            if(problem OR NOT type STREQUAL "BOOLEAN")
                message(FATAL_ERROR "Invalid discovery device boolean ${key}: ${discovery}")
            endif()
        endforeach()
        foreach(key IN ITEMS index device_memory_mib max_storage_buffer_bytes)
            string(JSON type ERROR_VARIABLE problem TYPE "${discovery}" devices ${i} ${key})
            if(problem OR NOT type STREQUAL "NUMBER")
                message(FATAL_ERROR "Invalid discovery device number ${key}: ${discovery}")
            endif()
        endforeach()
        string(JSON usable GET "${discovery}" devices ${i} usable)
        string(JSON software GET "${discovery}" devices ${i} software)
        if(usable)
            if(selected_index STREQUAL "")
                string(JSON selected_index GET "${discovery}" devices ${i} index)
            endif()
            if(NOT software)
                set(hardware_available TRUE)
            endif()
        endif()
    endforeach()
endif()

run_ok(--list-devices)
if(NOT last_output MATCHES "CPU reference renderer: available")
    message(FATAL_ERROR "Text discovery did not identify the CPU fallback: ${last_output}")
endif()
run_ok(--flame "${SAMPLE}" --output "${output}" --samples 16387 --seed 48 --threads 1 --backend cpu)
if(NOT last_output MATCHES "backend=cpu" OR last_output MATCHES "CPU fallback:")
    message(FATAL_ERROR "Explicit CPU command did not report actual backend: ${last_output}")
endif()
file(SHA256 "${output}" cpu_hash)
run_ok(--flame "${SAMPLE}" --output "${output}" --samples 16387 --seed 48 --threads 3)
file(SHA256 "${output}" default_hash)
if(NOT cpu_hash STREQUAL default_hash)
    message(FATAL_ERROR "Default CLI backend changed the established CPU output")
endif()

run_ok(--flame "${SAMPLE}" --output "${output}" --samples 16387 --seed 48 --backend vulkan
    --device __apophysis_missing_device__)
file(SHA256 "${output}" fallback_hash)
if(NOT cpu_hash STREQUAL fallback_hash OR NOT last_output MATCHES "backend=cpu" OR
   NOT last_output MATCHES "CPU fallback:")
    message(FATAL_ERROR "Missing-device fallback did not preserve/report CPU behavior: ${last_output}")
endif()
if(NOT hardware_available)
    run_ok(--flame "${SAMPLE}" --output "${output}" --samples 16387 --seed 48 --backend auto)
    file(SHA256 "${output}" automatic_hash)
    if(NOT cpu_hash STREQUAL automatic_hash OR NOT last_output MATCHES "backend=cpu" OR
       NOT last_output MATCHES "CPU fallback:")
        message(FATAL_ERROR "Automatic selection used software Vulkan or hid CPU fallback: ${last_output}")
    endif()
endif()

run_preserved_failure(--backend vulkan --device __apophysis_missing_device__ --no-fallback)
run_preserved_failure(--backend impossible)
run_preserved_failure(--gpu-memory-mib -1)
run_preserved_failure(--backend auto --memory-mib 1)
run_preserved_failure(--device)

if(NOT selected_index STREQUAL "")
    run_preserved_failure(--backend vulkan --device "${selected_index}" --gpu-memory-mib 1 --no-fallback)
    run_ok(--no-fallback --flame "${SAMPLE}" --output "${output}" --samples 16387 --seed 48
        --backend vulkan --device "${selected_index}" --gpu-memory-mib 128)
    file(READ "${output}" magic LIMIT 2 HEX)
    if(NOT magic STREQUAL "5036" OR NOT last_output MATCHES "backend=vulkan" OR
       last_output MATCHES "CPU fallback:")
        message(FATAL_ERROR "Explicit compute CLI output was invalid or concealed fallback: ${last_output}")
    endif()
    message(STATUS "Explicit Vulkan file rendering executed on device index ${selected_index}")
else()
    message(STATUS "No usable Vulkan device: discovery/CPU/failure cases passed; compute file rendering not run")
endif()
file(WRITE "${WORK}/discovery.json" "${discovery}")
message(STATUS "GPU CLI discovery, selection, fallback and output preservation checks passed")
