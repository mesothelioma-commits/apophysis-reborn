file(MAKE_DIRECTORY "${WORK}")
file(READ "${FIXTURES}/producer-oracle.flame" xml)
string(REPLACE "Apophysis 2.09" "Apophysis 7x" seven "${xml}")
file(WRITE "${WORK}/7x.flame" "${seven}")
string(REPLACE "version=\"Apophysis 7x\"" "version=\"Apophysis 7x\" enable_de=\"1\" estimator_radius=\"9\" estimator_minimum=\"0\" estimator_curve=\"0.4\"" seven_active "${seven}")
file(WRITE "${WORK}/7x-estimator-flag.flame" "${seven_active}")
foreach(input IN ITEMS "${FIXTURES}/producer-oracle.flame" "${WORK}/7x.flame" "${WORK}/7x-estimator-flag.flame")
    set(index 0)
    foreach(name IN ITEMS direct low gaussian even wide)
        math(EXPR index "${index} + 1")
        set(output "${WORK}/${name}.ppm")
        execute_process(COMMAND "${EXE}" --flame "${input}" --index "${index}" --threads 1 --output "${output}"
            RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
        if(NOT rc STREQUAL "0")
            message(FATAL_ERROR "${name}: ${err}")
        endif()
        file(SHA256 "${output}" actual)
        file(SHA256 "${FIXTURES}/producer-oracle-${name}.ppm" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${input} / ${name} differs from original Pascal reference")
        endif()
    endforeach()
endforeach()
