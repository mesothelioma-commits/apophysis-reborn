file(MAKE_DIRECTORY "${WORK}")
set(input "${WORK}/Mixed legacy.flame")
set(copy "${WORK}/copy.flame")
set(xml "<Flames name='Library'>\r\n  <!-- keep this comment -->\r\n  <flame name='Vendor &amp; Light' version='Apophysis 7x' size='20 20' vendor='3'><pluginSpecific value='2'/></flame>\r\n  <flame name='Clear' size='8 6' scale='2'><xform weight='1' linear='1' coefs='0 0 0 0 0 0'/><color index='0' rgb='40 0 200'/></flame>\r\n</Flames>\r\n")
file(WRITE "${input}" "${xml}")
function(run_ok)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE result ERROR_VARIABLE error)
    if(NOT rc STREQUAL "0")
        message(FATAL_ERROR "${ARGN}: ${error}")
    endif()
    set(result "${result}" PARENT_SCOPE)
endfunction()
function(run_bad)
    execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE error)
    if(rc STREQUAL "0")
        message(FATAL_ERROR "Should have failed: ${ARGN}")
    endif()
endfunction()
run_ok(inspect "${input}" --json)
string(JSON status GET "${result}" entries 0 status)
string(JSON name GET "${result}" entries 0 name)
string(JSON other GET "${result}" entries 1 status)
if(NOT status STREQUAL "preserve-only" OR NOT name STREQUAL "Vendor & Light" OR NOT other STREQUAL "renderable")
    message(FATAL_ERROR "Incorrect per-entry inspection: ${result}")
endif()
run_ok(save "${input}" --output "${copy}")
file(SHA256 "${input}" before)
file(SHA256 "${copy}" copied)
if(NOT before STREQUAL copied)
    message(FATAL_ERROR "Unedited save changed bytes")
endif()
run_ok(save "${copy}" --output "${copy}" --index 1 --name "New & Light")
string(REPLACE "Vendor &amp; Light" "New &amp; Light" renamed "${xml}")
string(SHA256 expected "${renamed}")
file(SHA256 "${copy}" edited)
if(NOT expected STREQUAL edited)
    message(FATAL_ERROR "Name edit changed other bytes")
endif()
run_bad(save "${copy}" --output "${copy}" --index 3 --name "Nope")
run_bad(save "${copy}" --output "${copy}" --scale -4)
run_bad(export "${input}" --index 1 --output "${copy}")
file(SHA256 "${copy}" unchanged)
if(NOT edited STREQUAL unchanged)
    message(FATAL_ERROR "Failed command damaged a saved file")
endif()
run_ok(export "${input}" --index 2 --output "${WORK}/single.flame")
run_ok(inspect "${WORK}/single.flame" --json)
string(JSON count LENGTH "${result}" entries)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Export should contain only the selected flame")
endif()
run_ok(--flame "${input}" --index 2 --samples 8000 --output "${WORK}/before.bmp")
run_ok(--flame "${WORK}/single.flame" --samples 8000 --output "${WORK}/after.bmp")
file(SHA256 "${WORK}/before.bmp" original_render)
file(SHA256 "${WORK}/after.bmp" export_render)
if(NOT original_render STREQUAL export_render)
    message(FATAL_ERROR "Selected render model changed in export")
endif()
file(SHA256 "${input}" final_hash)
if(NOT before STREQUAL final_hash)
    message(FATAL_ERROR "Source file was modified")
endif()

# The bundled 2.08 3D Hack source uses JuliaN and planar linear3D in the same transform.
run_ok(inspect "${HISTORICAL}" --json)
string(JSON fox_status GET "${result}" entries 0 status)
if(NOT fox_status STREQUAL "renderable")
    message(FATAL_ERROR "Historical 3D Hack flame should render: ${result}")
endif()
run_ok(save "${HISTORICAL}" --output "${WORK}/historical-copy.flame")
file(SHA256 "${HISTORICAL}" old)
file(SHA256 "${WORK}/historical-copy.flame" new)
if(NOT old STREQUAL new)
    message(FATAL_ERROR "Historical source bytes changed on save")
endif()
run_ok(export "${HISTORICAL}" --output "${WORK}/historical-model.flame")
run_ok(--flame "${HISTORICAL}" --samples 120000 --threads 1 --output "${WORK}/historical-direct.bmp")
run_ok(--flame "${WORK}/historical-model.flame" --samples 120000 --threads 2 --output "${WORK}/historical-model.bmp")
file(SHA256 "${WORK}/historical-direct.bmp" direct)
file(SHA256 "${WORK}/historical-model.bmp" model)
if(NOT direct STREQUAL model)
    message(FATAL_ERROR "Standalone export changed the historical 3D Hack render")
endif()
